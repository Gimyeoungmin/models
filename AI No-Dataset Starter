HUMAN_LOOP_PY = r'''"""Simulate human-in-the-loop: model proposes labels, user confirms -> retrain."""
import os, json, random
import numpy as np
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.linear_model import LogisticRegression
from utils.logging_utils import setup_logging

log = setup_logging("humanloop")

# Seed small labeled set
L_LABELED = [
    ("I love it", 1),
    ("Hate this", 0),
]

# Unlabeled pool
UNLABELED = ["Great value", "Awful performance", "So-so", "Good battery", "Bad sound"]

vec = CountVectorizer()
X0 = vec.fit_transform([t for t,_ in L_LABELED])
y0 = np.array([y for _,y in L_LABELED])

clf = LogisticRegression(max_iter=200).fit(X0, y0)

confirmed = []
for tx in UNLABELED:
    prob = clf.predict_proba(vec.transform([tx]))[0]
    pred = int(prob[1] > 0.5)
    conf = prob.max()
    # "Human" step: auto-accept if confident >0.8 else ask user.
    if conf > 0.8:
        label = pred
        source = "auto"
    else:
        # Ask user (simulated w/ random ground truth) - replace w/ input() in real use.
        # ground truth simulation: positive if word 'good' or 'great' etc.
        gt = 1 if any(k in tx.lower() for k in ["good","great","love","value","battery"]) else 0
        label = gt
        source = "human"
    confirmed.append((tx, label, source))
    log.info(f"Added {tx!r} label={label} via {source} (conf={conf:.2f})")

# Retrain with added labels
train_texts = [t for t,_ in L_LABELED] + [t for t,_,_ in confirmed]
train_labels = [y for _,y in L_LABELED] + [y for _,y,_ in confirmed]
X = vec.fit_transform(train_texts)
y = np.array(train_labels)
clf = LogisticRegression(max_iter=200).fit(X, y)
log.info("Retrained with human feedback.")

# Save dataset we built
out_path = os.path.join(os.path.dirname(__file__), "data", "human_loop_dataset.jsonl")
os.makedirs(os.path.dirname(out_path), exist_ok=True)
with open(out_path, 'w', encoding='utf-8') as f:
    for (t,l,src) in confirmed:
        f.write(json.dumps({"text":t, "label":l, "source":src}, ensure_ascii=False) + "\n")
log.info(f"Wrote augmented dataset -> {out_path}")
'''


