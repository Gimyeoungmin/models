TRANSFER_LEARNING_VISION_PY = r'''"""Transfer learning demo: fine-tune a pretrained CNN on a tiny custom dataset."""
import os, torch
from torch import nn, optim
from torchvision import datasets, transforms, models
from utils.logging_utils import setup_logging

log = setup_logging("transfer")

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Use torchvision's FakeData to simulate having a *tiny* custom dataset.
transform = transforms.Compose([
    transforms.Resize((224,224)),
    transforms.ToTensor(),
])
train_ds = datasets.FakeData(size=64, image_size=(3,224,224), num_classes=2, transform=transform)
train_loader = torch.utils.data.DataLoader(train_ds, batch_size=8, shuffle=True)

# Load pretrained backbone
model = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)
for p in model.parameters():
    p.requires_grad = False  # freeze backbone

# Replace final head
num_feats = model.fc.in_features
model.fc = nn.Linear(num_feats, 2)
model.to(device)

criterion = nn.CrossEntropyLoss()
optimizer = optim.Adam(model.fc.parameters(), lr=1e-3)

model.train()
for epoch in range(3):
    total, correct, loss_sum = 0, 0, 0.0
    for x, y in train_loader:
        x, y = x.to(device), y.to(device)
        optimizer.zero_grad()
        out = model(x)
        loss = criterion(out, y)
        loss.backward()
        optimizer.step()
        loss_sum += loss.item()*x.size(0)
        pred = out.argmax(1)
        correct += (pred==y).sum().item()
        total += y.size(0)
    log.info(f"Epoch {epoch+1}: loss={loss_sum/total:.4f} acc={correct/total:.3f}")

# Save weights
out_path = os.path.join(os.path.dirname(__file__), "data", "transfer_resnet18.pt")
os.makedirs(os.path.dirname(out_path), exist_ok=True)
torch.save(model.state_dict(), out_path)
log.info(f"Saved fine-tuned head -> {out_path}")
'''


