ZERO_FEWSHOT_PY = r'''"""Demonstrate zero-shot & few-shot classification w/ OpenAI or local LLM."""
import os, json
from utils.logging_utils import setup_logging

log = setup_logging("zerofew")

# For demonstration we implement a *fake* LLM classifier using keyword rules
# when OPENAI_API_KEY is not set. This keeps script runnable offline.

OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")

FEW_SHOT_EXAMPLES = [
    {"text": "I love this!", "label": "Positive"},
    {"text": "This is terrible.", "label": "Negative"},
]

KEYWORDS_POS = {"love", "great", "good", "amazing", "happy"}
KEYWORDS_NEG = {"bad", "terrible", "hate", "awful", "sad"}

def rule_classify(text: str) -> str:
    low = text.lower()
    if any(k in low for k in KEYWORDS_POS):
        return "Positive"
    if any(k in low for k in KEYWORDS_NEG):
        return "Negative"
    return "Neutral"


def classify_texts(texts):
    # If you have API, you'd build a prompt with FEW_SHOT_EXAMPLES.
    # Here we use rule fallback.
    results = []
    for tx in texts:
        results.append({"text": tx, "prediction": rule_classify(tx)})
    return results

if __name__ == "__main__":
    samples = ["I hate the lag", "Pretty good overall", "meh"]
    preds = classify_texts(samples)
    log.info(json.dumps(preds, ensure_ascii=False, indent=2))
'''


