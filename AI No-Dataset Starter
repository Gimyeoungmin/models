SYNTHETIC_TEXTGEN_PY = r'''"""Generate pseudo labeled sentiment data using an LLM + rule heuristics."""
import os, json, random
from typing import List, Dict
from utils.logging_utils import setup_logging

# If you have OpenAI access, you can call it; fallback to templates.
# (We keep this offline-friendly by using templates when API key missing.)

log = setup_logging("synthetic")

POS_TEMPLATES = [
    "I absolutely loved this product!", "Fantastic experience, will buy again.",
    "Superb quality and great support.", "Better than expected!" ]
NEG_TEMPLATES = [
    "Terrible, broke on day one.", "Very disappointing and overpriced.",
    "Would not recommend to anyone.", "Poor quality and slow delivery." ]

NEU_TEMPLATES = ["It's okay.", "Average.", "Nothing special.", "Fine for the price."]

LABEL_MAP = {"pos":1, "neg":0, "neu":2}

def synth_samples(n_per_class=50):
    data = []
    for _ in range(n_per_class):
        data.append({"text": random.choice(POS_TEMPLATES), "label": LABEL_MAP['pos']})
        data.append({"text": random.choice(NEG_TEMPLATES), "label": LABEL_MAP['neg']})
        data.append({"text": random.choice(NEU_TEMPLATES), "label": LABEL_MAP['neu']})
    random.shuffle(data)
    return data

if __name__ == "__main__":
    ds = synth_samples(100)
    out_path = os.path.join(os.path.dirname(__file__), "data", "synthetic_sentiment.jsonl")
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    with open(out_path, 'w', encoding='utf-8') as f:
        for row in ds:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
    log.info(f"Wrote {len(ds)} synthetic rows -> {out_path}")
'''


